--cpu=Cortex-M4.fp.sp
"imu_init\startup_stm32f407xx.o"
"imu_init\main.o"
"imu_init\gpio.o"
"imu_init\i2c.o"
"imu_init\usart.o"
"imu_init\stm32f4xx_it.o"
"imu_init\stm32f4xx_hal_msp.o"
"imu_init\mpu6050.o"
"imu_init\stm32f4xx_hal_i2c.o"
"imu_init\stm32f4xx_hal_i2c_ex.o"
"imu_init\stm32f4xx_hal_rcc.o"
"imu_init\stm32f4xx_hal_rcc_ex.o"
"imu_init\stm32f4xx_hal_flash.o"
"imu_init\stm32f4xx_hal_flash_ex.o"
"imu_init\stm32f4xx_hal_flash_ramfunc.o"
"imu_init\stm32f4xx_hal_gpio.o"
"imu_init\stm32f4xx_hal_dma_ex.o"
"imu_init\stm32f4xx_hal_dma.o"
"imu_init\stm32f4xx_hal_pwr.o"
"imu_init\stm32f4xx_hal_pwr_ex.o"
"imu_init\stm32f4xx_hal_cortex.o"
"imu_init\stm32f4xx_hal.o"
"imu_init\stm32f4xx_hal_exti.o"
"imu_init\stm32f4xx_hal_uart.o"
"imu_init\system_stm32f4xx.o"
--strict --scatter "IMU_Init\IMU_Init.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "IMU_Init.map" -o IMU_Init\IMU_Init.axf